option "title" "Yala Test Ledger"
option "operating_currency" "USD"

2020-01-01 commodity USD

; ------------------------------------------------
; Cash Accounts
; ------------------------------------------------
2020-01-01 open Assets:Cash:BankA USD
2020-01-01 open Assets:Cash:BankB USD
2020-01-01 open Assets:Cash:Wallet USD
2020-01-01 open Assets:Cash:Passthrough USD
  sweep_to: "Assets:Cash:Savings"
2020-01-01 open Assets:Cash:Savings USD
2020-01-01 open Assets:Receivable:Friends USD

; ------------------------------------------------
; Spendings
; ------------------------------------------------
2020-01-01 open Expenses:Grocery USD
2020-01-01 open Expenses:Subscription USD
2020-01-01 open Expenses:Takeouts USD

; ------------------------------------------------
; Credit Cards
; ------------------------------------------------
2020-01-01 open Liabilities:CC:CardA USD
2020-01-01 open Liabilities:CC:CardB USD
2026-08-14 open Liabilities:CC:CardC USD

; ------------------------------------------------
; Payroll — one employer still paying, one left behind so the closed case is covered
; ------------------------------------------------
2020-01-01 open Income:Salary:Employer1 USD
2020-01-01 open Income:Salary:Employer2 USD
2022-01-01 close Income:Salary:Employer2

; A deduction with no `employer` is offered by every employer; one that names an employer is
; offered by that employer alone.
2020-01-01 open Expenses:Deductions:Tax USD
2020-01-01 open Expenses:Deductions:Insurance USD
2020-01-01 open Expenses:Deductions:Employer1Benefit USD
  employer: "Employer1"

; An `employer` meta marks an investment account payroll-contributable; `labels` lists the line
; items it offers, and the chosen one is recorded per posting so net worth still sees a single pot.
2020-01-01 open Assets:Investments:TaxAdvantaged:Broker1HSA
  labels: "HSA"
  employer: "Employer1"
2020-01-01 open Assets:Investments:TaxAdvantaged:Employer401k USD
  labels: "Roth401k,Trad401k,AfterTax401k"
  employer: "Employer1"

; Closed, so the option lists have an inactive account to filter out.
2020-01-01 open Assets:Investments:TaxAdvantaged:LegacyPlan
  labels: "LegacyPlan"
  employer: "Employer1"
2026-08-21 close Assets:Investments:TaxAdvantaged:LegacyPlan

; ------------------------------------------------
; Equity — opening balances, and one adjustment plug per snapshot-able account.
; The plug keeps the investment tax tier, so two accounts differing only by tier never share one.
; A passthrough gets none: its balance is swept.
; ------------------------------------------------
2020-01-01 open Equity:Opening-Balances
2020-01-01 open Equity:Adjustments:BankA
2020-01-01 open Equity:Adjustments:BankB
2020-01-01 open Equity:Adjustments:Wallet
2020-01-01 open Equity:Adjustments:Savings
2020-01-01 open Equity:Adjustments:Investments:TaxAdvantaged:Broker1HSA
2020-01-01 open Equity:Adjustments:Investments:TaxAdvantaged:Employer401k

; ------------------------------------------------
; Closed, so the active-account lists have something to filter out
; ------------------------------------------------
2020-01-01 open Liabilities:CC:CardD USD
2024-10-01 close Liabilities:CC:CardD
